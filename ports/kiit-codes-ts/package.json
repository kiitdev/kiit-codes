{
  "name": "@kiitdev/codes",
  "version": "1.0.0",
  "description": "General purpose status codes, for any layer of your app, to classify success and failure",
  "keywords": [
    "status",
    "error-handling",
    "status-codes",
    "typescript",
    "http-status",
    "problem-details",
    "rfc9457"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "homepage": "https://kiit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiitdev/kiit-codes.git",
    "directory": "ports/kiit-codes-ts"
  },
  "bugs": {
    "url": "https://github.com/kiitdev/kiit-codes/issues"
  },
  "author": "CodeHelix <https://kiit.dev>",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:consumers": "bash scripts/check-consumers.sh",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "5.9.3",
    "vitest": "^5.0.0"
  }
}
