{
  "name": "@kiitdev/codes",
  "version": "0.9.0",
  "description": "Typed status and error codes for structured success and failure classification",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "license": "Apache-2.0",
  "homepage": "https://kiit.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kiitdev/kiit-codes.git",
    "directory": "ports/kiit-codes-ts"
  },
  "bugs": {
    "url": "https://github.com/kiitdev/kiit-codes/issues"
  },
  "author": "CodeHelix <https://kiit.dev>",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
